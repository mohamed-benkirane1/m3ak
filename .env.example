# Reasoning — GPT-5.5, generic OpenAI-compatible transport.
# LLM_URL is the FULL chat-completions request URL (e.g. an
# "/openai/v1"-style base with "/chat/completions" appended), not merely a
# host/base URL — the transport POSTs to it exactly as given, with no path
# appended.
LLM_URL=<FULL_OPENAI_COMPATIBLE_CHAT_COMPLETIONS_URL>
LLM_API_KEY=<YOUR_REASONING_API_KEY>
LLM_REASONING_MODEL=<YOUR_REASONING_MODEL>

# Fast — official Azure OpenAI deployment (GPT-4.1). The request URL is
# composed from these at call time:
# {AZURE_OPENAI_ENDPOINT}/openai/deployments/{AZURE_OPENAI_DEPLOYMENT_NAME}/chat/completions?api-version={AZURE_OPENAI_API_VERSION}
AZURE_OPENAI_API_KEY=<YOUR_AZURE_OPENAI_API_KEY>
AZURE_OPENAI_ENDPOINT=<YOUR_AZURE_RESOURCE_ENDPOINT>
AZURE_OPENAI_API_VERSION=<YOUR_AZURE_API_VERSION>
AZURE_OPENAI_DEPLOYMENT_NAME=<YOUR_AZURE_DEPLOYMENT_NAME>
AZURE_OPENAI_MAX_TOKENS=<YOUR_POSITIVE_INTEGER_LIMIT>

# Embeddings � optionnel, non utilis� dans le MVP initial
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=512

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_URL=

# Agent
MAX_AGENT_STEPS=6

# Follow-up
FOLLOWUP_DELAY_MINUTES=5

# Application
API_PORT=3001
WEB_PORT=5173
VITE_WS_URL=
NODE_ENV=development
