{
  "name": "@m3ak/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node-pg-migrate up -m db/migrations",
    "db:migrate:down": "node-pg-migrate down -m db/migrations"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "9.0.0"
  }
}
