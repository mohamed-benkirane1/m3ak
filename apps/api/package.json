{
  "name": "@m3ak/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node-pg-migrate up -m db/migrations",
    "db:migrate:down": "node-pg-migrate down -m db/migrations",
    "db:seed": "tsc -p tsconfig.json && node dist/db/seed/kenza.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.16",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@m3ak/shared": "0.1.0",
    "bullmq": "6.3.8",
    "csv-parse": "7.0.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.1",
    "node-pg-migrate": "9.0.0",
    "vitest": "4.1.11"
  }
}
